generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model agents {
  id  String  @id  @default(cuid())
  tdrId            String
  tdrName          String
  zone             String
  zbmName          String
  agentName        String
  agentCode        String    @unique
  contactPhone     String
  type             AgentType
  merchantCategory String?
  initialFloat     Float     @default(0)
  town             String
  address          String?
  cluster          String?
  market           String?
  latitude         Float?
  longitude        Float?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  users            users     @relation(fields: [tdrId], references: [id])
}

model float_issues {
  id  String  @id  @default(cuid())
  tdrId           String
  tdrName         String
  zone            String
  agentCode       String
  agentName       String
  contactPhone    String
  issueType       IssueType
  reportedFloat   Float       @default(0)
  description     String
  status          IssueStatus @default(reported)
  resolvedAt      DateTime?
  resolvedBy      String?
  resolutionNotes String?
  latitude        Float?
  longitude       Float?
  reportedAt      DateTime    @default(now())
  updatedAt  DateTime  @updatedAt
  users           users       @relation(fields: [tdrId], references: [id])
}

model prospects {
  id  String  @id  @default(cuid())
  tdrId               String
  tdrName             String
  zone                String
  prospectType        ProspectType
  businessName        String
  ownerName           String
  contactPhone        String
  town                String
  address             String?
  merchantCategory    String?
  estimatedFloat      Float?
  status              ProspectStatus @default(identified)
  notes               String?
  followUpDate        DateTime?
  convertedAt         DateTime?
  latitude            Float?
  longitude           Float?
  createdAt           DateTime       @default(now())
  updatedAt  DateTime  @updatedAt
  closedByTdr         Boolean        @default(false)
  zbmApprovalRequired Boolean        @default(false)
  users               users          @relation(fields: [tdrId], references: [id])
}

model sales_targets {
  id  String  @id  @default(cuid())
  zone            String
  period          String
  targetAgents    Int      @default(96)
  targetMerchants Int      @default(96)
  targetOutlets   Int      @default(20)
  setByHsdId      String
  createdAt       DateTime @default(now())
  updatedAt  DateTime  @updatedAt
  users           users    @relation(fields: [setByHsdId], references: [id])

  @@unique([zone, period])
}

model users {
  id  String  @id  @default(cuid())
  name          String
  pin           String
  role          Role
  zone          String?
  active        Boolean         @default(true)
  mustChangePin Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt  DateTime  @updatedAt
  aseId         String?
  agents        agents[]
  float_issues  float_issues[]
  prospects     prospects[]
  sales_targets sales_targets[]
  visits        visits[]
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model visits {
  id  String  @id  @default(cuid())
  tdrId        String
  tdrName      String
  zone         String
  zbmName      String
  outletName   String
  agentCode    String
  contactPhone String
  town         String
  cluster      String?
  market       String?
  floatAmount  Float    @default(0)
  latitude     Float?
  longitude    Float?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt  DateTime  @updatedAt
  users        users    @relation(fields: [tdrId], references: [id])
}

enum AgentType {
  normal
  merchant
}

enum IssueStatus {
  reported
  in_progress
  resolved
}

enum IssueType {
  low_float
  stuck_transaction
  system_error
  other
}

enum ProspectStatus {
  identified
  contacted
  interested
  converted
  follow_up
  rejected
}

enum ProspectType {
  agent
  merchant
}

enum Role {
  TDR
  ZBM
  HSD
  ASE
}
