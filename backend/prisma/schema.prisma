generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agent {
  id               String    @id @default(cuid())
  tdrId            String
  tdrName          String
  zone             String
  zbmName          String
  agentName        String
  agentCode        String    @unique
  contactPhone     String
  type             AgentType
  merchantCategory String?
  initialFloat     Float     @default(0)
  town             String
  address          String?
  cluster          String?
  market           String?
  latitude         Float?
  longitude        Float?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [tdrId], references: [id])

  @@map("agents")
}

model FloatIssue {
  id              String      @id @default(cuid())
  tdrId           String
  tdrName         String
  zone            String
  agentCode       String
  agentName       String
  contactPhone    String
  issueType       IssueType
  reportedFloat   Float       @default(0)
  description     String
  status          IssueStatus @default(reported)
  resolvedAt      DateTime?
  resolvedBy      String?
  resolutionNotes String?
  reportedAt      DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  latitude        Float?
  longitude       Float?
  user            User        @relation(fields: [tdrId], references: [id])

  @@map("float_issues")
}

model Prospect {
  id                  String         @id @default(cuid())
  tdrId               String
  tdrName             String
  zone                String
  prospectType        ProspectType
  businessName        String
  ownerName           String
  contactPhone        String
  town                String
  address             String?
  merchantCategory    String?
  estimatedFloat      Float?
  status              ProspectStatus @default(identified)
  notes               String?
  followUpDate        DateTime?
  convertedAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  closedByTdr         Boolean        @default(false)
  zbmApprovalRequired Boolean        @default(false)
  latitude            Float?
  longitude           Float?
  user                User           @relation(fields: [tdrId], references: [id])

  @@map("prospects")
}

model SalesTarget {
  id              String   @id @default(cuid())
  zone            String
  period          String
  targetAgents    Int      @default(96)
  targetMerchants Int      @default(96)
  targetOutlets   Int      @default(20)
  setByHsdId      String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [setByHsdId], references: [id])

  @@unique([zone, period])
  @@map("sales_targets")
}

model User {
  id            String         @id @default(cuid())
  name          String
  pin           String
  role          Role
  zone          String?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  aseId         String?
  mustChangePin Boolean        @default(false)
  agents        Agent[]
  floatIssues   FloatIssue[]
  odrOutlets    OdrOutlet[]    @relation("TdrOdrOutlets")
  prospects     Prospect[]
  reactivations Reactivation[]
  salesTargets  SalesTarget[]
  ssoOdrTargets SsoOdrTarget[] @relation("ZbmSsoOdrTargets")
  ssoOutlets    SsoOutlet[]    @relation("TdrSsoOutlets")
  visits        Visit[]
  siteFocuses   SiteFocus[]    @relation("AseSiteFocus")

  @@map("users")
}

model SsoOutlet {
  id           String   @id @default(cuid())
  tdrId        String
  tdrName      String
  aseId        String?
  aseName      String?
  zone         String
  outletName   String
  ownerName    String
  contactPhone String
  town         String
  address      String?
  cluster      String?
  deviceType   String   @default("SSO")
  msisdn       String?
  simSerial    String?
  imei         String?
  notes        String?
  latitude     Float?
  longitude    Float?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation("TdrSsoOutlets", fields: [tdrId], references: [id])

  @@map("sso_outlets")
}

model OdrOutlet {
  id           String   @id @default(cuid())
  tdrId        String
  tdrName      String
  aseId        String?
  aseName      String?
  zone         String
  outletName   String
  ownerName    String
  contactPhone String
  town         String
  address      String?
  cluster      String?
  deviceType   String   @default("Zamtel")
  msisdn       String?
  simSerial    String?
  imei         String?
  notes        String?
  latitude     Float?
  longitude    Float?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation("TdrOdrOutlets", fields: [tdrId], references: [id])

  @@map("odr_outlets")
}

model SsoOdrTarget {
  id         String   @id @default(cuid())
  zone       String
  period     String
  targetSso  Int      @default(10)
  targetOdr  Int      @default(10)
  setByZbmId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation("ZbmSsoOdrTargets", fields: [setByZbmId], references: [id])

  @@unique([zone, period])
  @@map("sso_odr_targets")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Visit {
  id           String   @id @default(cuid())
  tdrId        String
  tdrName      String
  zone         String
  zbmName      String
  outletName   String
  agentCode    String
  contactPhone String
  town         String
  cluster      String?
  market       String?
  floatAmount  Float    @default(0)
  latitude     Float?
  longitude    Float?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [tdrId], references: [id])

  @@map("visits")
}

model Reactivation {
  id           String   @id @default(cuid())
  tdrId        String
  tdrName      String
  zone         String
  agentCode    String
  agentName    String
  contactPhone String
  town         String
  cluster      String?
  market       String?
  floatAmount  Float    @default(0)
  latitude     Float?
  longitude    Float?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isNtBase     Boolean  @default(false)
  ntPoints     Int      @default(0)
  user         User     @relation(fields: [tdrId], references: [id])

  @@map("reactivations")
}

/// NT Base codes — managed via raw SQL, not Prisma client
/// 86,411+ rows; never drop this table via db push
model NtCode {
  id        Int      @id @default(autoincrement())
  agentCode String   @unique @map("agent_code")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("nt_codes")
}

model KycDevice {
  id             String   @id @default(cuid())
  dealerCode     String?
  description    String?
  imei1          String?
  imei2          String?
  msisdn         String?
  simSerial      String?
  siteId         String?
  region         String?
  zone           String?
  rbmName        String?
  aseName        String?
  teamLead       String?
  status         String   @default("ACTIVE")
  activityStatus Int      @default(0)
  kycReg         Int      @default(0)
  grossAdds      Int      @default(0)
  zamoGA         Int      @default(0)
  recharges      Float    @default(0)
  deviceSource   String   @default("MobiGO2+")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("kyc_devices")
}

enum AgentType {
  normal
  merchant
}

enum IssueStatus {
  reported
  in_progress
  resolved
}

enum IssueType {
  low_float
  stuck_transaction
  system_error
  other
}

enum ProspectStatus {
  identified
  contacted
  interested
  converted
  rejected
  follow_up
}

enum ProspectType {
  agent
  merchant
}

enum Role {
  TDR
  ZBM
  HSD
  ASE
  DM
}

// ── Weekly Site Focus ─────────────────────────────────────────────────────────
model SiteFocus {
  id          String   @id @default(cuid())
  aseId       String
  weekStart   DateTime // Monday of the ISO week
  siteName    String
  siteId      String   // site reference / location ID
  agentsRec   Int      @default(0)   // agents recruited at this site
  ssosRec     Int      @default(0)   // SSOs recruited
  odrsRec     Int      @default(0)   // ODRs recruited
  dataActs    Int      @default(0)   // customers activated on Data offers
  dtuSold     Float    @default(0)   // Direct Top Up — total amount sold in ZMW (one-off; target K500)
  dtuAgentCode String?                // agent code the Direct Top Up was sold from
  agentCodes  String?  // comma-separated actual agent codes created at this site
  ssoCodes    String?  // comma-separated actual SSO codes created at this site
  odrCodes    String?  // comma-separated actual ODR codes created at this site
  latitude    Float?   // GPS latitude captured by ASE at site
  longitude   Float?   // GPS longitude captured by ASE at site
  status      String   @default("planned")  // 'planned' | 'visited'
  plannedDate DateTime?                      // date the ASE plans to visit
  visitedAt   DateTime?                      // when actual results were recorded
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ase         User     @relation("AseSiteFocus", fields: [aseId], references: [id])

  @@map("site_focus")
}
